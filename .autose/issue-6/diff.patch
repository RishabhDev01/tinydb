+
+def append(field: str, val: Any) -> Callable[[MutableMapping], None]:
+    """
+    Append ``val`` to a list field, creating it as a single-element list
+    if it does not exist.
+    """
+    def transform(doc: MutableMapping):
+        if field in doc:
+            doc[field].append(val)
+        else:
+            doc[field] = [val]
+
+    return transform
